#include "credentials.h"

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET  -1
unsigned long artcounter =0;
int dispcounter = 0;

int lrdpin = 34;
int lut = 0;

float temp = 0;
float humid = 0;

bool lutstatus = true;

#define DHTPIN 4
#define DHTTYPE DHT22

Adafruit_SSD1306 display(SCREEN_WIDTH,SCREEN_HEIGHT,&Wire,OLED_RESET);
LiquidCrystal_I2C lcd(0x27, 16, 2);

DHT dht(DHTPIN,DHTTYPE);

extern const unsigned char art1[] PROGMEM;
extern const unsigned char art2[] PROGMEM;
extern const unsigned char art3[] PROGMEM;

extern const unsigned char* const bitmapArray[] PROGMEM; //Art Index array

unsigned long previous = 0;
const long interval = 2000;

/* OLED drift (antiburn-in) variables
int offsetY =0;
int offsetX =0;
unsigned long glide =0;
*/

unsigned long arttimer =0;
int artint = 0;

//PROTOTYPE FUNCTIONS;

void art(unsigned const char* nextArt);
void tstat(); //Prints physical status to the Displays;
void wstat(); //Prints wifi status to the displays;
void ifnan();
void antiburnin(); //Register if you are using OLED;
void lutstat();


///;;;;;;SETUP;;;;;;;;;

void setup(){
  Serial.begin(115200);
  Serial.println(F("Initializing"));

  dht.begin(); //Starting up the DHT22;

	display.begin(SSD1306_SWITCHCAPVCC, 0x3C);

	pinMode(lrdpin, INPUT);
	analogSetAttenuation(ADC_11db);

	/*
  if(!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)){
    Serial.println(F("Allocation Failed"));
    for(;;);
  }
	*/

	lcd.init();
	lcd.backlight();
	lcd.clear();
	lcd.home();
	lcd.print("Environment");
	lcd.setCursor(0, 1);
	lcd.print("Loading...");

  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(0,10);
  display.println(F("Initializing"));
  display.display();
  display.clearDisplay();
  display.drawBitmap(0, 0, art3, 128, 64, WHITE);
  display.display();
  delay(5000);
}


///SETUP ENDS;


void loop(){

  unsigned long current = millis();

  if(current - previous >= interval){     //2 Second, Non Blocking Function;

    previous = current;  
    temp = dht.readTemperature();
    humid = dht.readHumidity();
		
		if (isnan(humid) || isnan(temp)) {
    ifnan();
		}
		
		switch(dispcounter){
			case 0:
				tstat();
				break;

			case 1:
				wstat();
				break;

			case 2:
				lutstat();	
				break;

		}

		lut = analogRead(lrdpin);

		dispcounter = ((dispcounter + 1) % 3);

		if(millis()-artcounter>10000){ 
			artcounter = millis();
			display.ssd1306_command(SSD1306_DISPLAYOFF);
		}
		
		antiburnin(); //OLED Anti Burn-In Strategy;
		
		if(millis()-arttimer > 21000){
			arttimer = millis();
			unsigned const char* arttemp = bitmapArray[artint];
			art(arttemp);
			artint++;
			if(artint == 3){
				artint=0;
			}
		}
		if(lut < 600 && lutstatus == true){
			lutstatus = false;
			lcd.noBacklight();
		}
		if(lut > 1400 && lutstatus == false){
			lutstatus = true;
			lcd.backlight();
		}
  }
}


///;;;;;;;;LOOP FUNCTION ENDS;;;;;;;;


///DECLARED FUNCTIONS;;;;;;;;

void lutstat(){
	lcd.clear();
	lcd.print(F("Room Light Value"));
	lcd.setCursor(0,1);
	lcd.print(F("= "));
	lcd.print(lut);
	Serial.println("LUT:");
	Serial.println(lut);
}

